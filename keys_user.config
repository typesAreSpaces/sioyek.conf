zoom_in  K
zoom_out J

toggle_custom_color i

goto_toc I

move_left  l
move_right h

escape <C-g>

copy yy

#_path_info <C-a>
_path_clipboard <C-a>
_open_in_terminal <C-b>
_prompt_review <C-r>

# Navigate searchable menus with Ctrl-P / Ctrl-N.
[m]control_menu(up) <C-p>
[m]control_menu(down) <C-n>

goto_next_tab <tab>
goto_prev_tab <S-<tab>>
# macOS can send Shift+Tab as the control character U+0019.
goto_prev_tab 
goto_tab T

# Keep these commands accessible alongside h/l movement.
add_highlight H
overview_definition L

